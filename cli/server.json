{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.FROWNINGdev/django-orm-lens",
  "title": "Django ORM Lens",
  "description": "Django ORM static-analysis MCP. 10 tools: models, relations, migrations, indexes, signals, N+1.",
  "version": "1.5.1",
  "repository": {
    "url": "https://github.com/FROWNINGdev/django-orm-lens",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "django-orm-lens",
      "version": "1.5.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "django-orm-lens[mcp]"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "django-orm-lens-mcp"
        }
      ]
    }
  ]
}
