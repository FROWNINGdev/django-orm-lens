{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.FROWNINGdev/orm-lens",
  "title": "ORM Lens",
  "description": "Django and SQLAlchemy static analysis: models, relations, migrations, Alembic, N+1.",
  "version": "1.16.0",
  "repository": {
    "url": "https://github.com/FROWNINGdev/orm-lens",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "orm-lens",
      "version": "1.16.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "orm-lens[mcp]"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "orm-lens-mcp"
        }
      ]
    }
  ]
}
