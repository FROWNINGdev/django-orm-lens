{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nam-tong/db-synapse",
  "title": "DB Synapse",
  "description": "Django ORM static analysis MCP. Models, relations, migrations, indexes, signals, N+1.",
  "version": "1.13.3",
  "repository": {
    "url": "https://github.com/nam-tong/db-synapse",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "db-synapse",
      "version": "1.13.3",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "db-synapse[mcp]"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "db-synapse-mcp"
        }
      ]
    }
  ]
}
