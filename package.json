{
  "name": "db-synapse",
  "displayName": "DB Synapse",
  "description": "Autocomplete Django model fields and lookups inside .filter(), and see your entire schema in your editor. Live sidebar, ER diagrams, impact analysis, blast radius and schema drift. Static analysis - no DB, no Django boot. Free and MIT, no Pro tier.",
  "version": "0.19.4",
  "preview": false,
  "galleryBanner": {
    "color": "#0c4b33",
    "theme": "dark"
  },
  "qna": "marketplace",
  "sponsor": {
    "url": "https://github.com/sponsors/nam-tong"
  },
  "publisher": "frowningdev",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nam-tong/db-synapse.git"
  },
  "bugs": {
    "url": "https://github.com/nam-tong/db-synapse/issues"
  },
  "homepage": "https://github.com/nam-tong/db-synapse#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "AI",
    "Other"
  ],
  "keywords": [
    "django",
    "python",
    "orm",
    "models",
    "er diagram",
    "erd",
    "entity relationship",
    "database",
    "database schema",
    "schema",
    "schema visualizer",
    "model explorer",
    "foreign key",
    "relations",
    "relationships",
    "django-rest-framework",
    "drf",
    "postgres",
    "postgresql",
    "static analysis",
    "n+1",
    "query optimization",
    "mcp",
    "ai agent",
    "cursor",
    "vscodium",
    "sidebar",
    "navigation",
    "migration",
    "free",
    "open source",
    "code review",
    "pull request",
    "schema drift",
    "impact analysis",
    "blast radius",
    "autocomplete",
    "intellisense",
    "completion",
    "queryset",
    "filter",
    "lookup"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/manage.py",
    "workspaceContains:**/models.py"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbSynapse",
          "title": "DB Synapse",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "dbSynapse": [
        {
          "id": "dbSynapse.models",
          "name": "Models",
          "icon": "media/activitybar.svg",
          "contextualTitle": "Django Models"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbSynapse.models",
        "when": "workbenchState == empty",
        "contents": "**Open a folder to get started.**\n\nDB Synapse indexes every `models.py` in your project and gives you a live schema tree, an ER diagram, hover cards, and inline QuickFixes for common ORM anti-patterns.\n\n[Open Folder](command:vscode.openFolder)\n\n[Documentation](https://github.com/nam-tong/db-synapse#readme)"
      },
      {
        "view": "dbSynapse.models",
        "when": "workbenchState != empty && !dbSynapse.scanCompleted",
        "contents": "**Scanning your workspace…**\n\nDB Synapse is walking your project for `models.py` files. This usually takes under a second.\n\nIf the scan doesn't finish, click Refresh below.\n\n[Refresh scan](command:dbSynapse.refresh)"
      },
      {
        "view": "dbSynapse.models",
        "when": "workbenchState != empty && dbSynapse.scanCompleted",
        "contents": "**No Django models found in this workspace.**\n\nDB Synapse scans for `models.py` files and split `models/` package directories, skipping `migrations/`, `venv/`, and `node_modules/` by default.\n\n[Refresh scan](command:dbSynapse.refresh)\n\n[Adjust excluded paths](command:workbench.action.openSettings?%22dbSynapse.excludeGlobs%22)\n\n[Documentation](https://github.com/nam-tong/db-synapse#readme)"
      }
    ],
    "commands": [
      {
        "command": "dbSynapse.refresh",
        "title": "DB Synapse: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbSynapse.showGraph",
        "title": "DB Synapse: Show ER Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbSynapse.jumpToModel",
        "title": "DB Synapse: Jump to Model"
      },
      {
        "command": "dbSynapse.filter",
        "title": "DB Synapse: Filter Models",
        "icon": "$(filter)"
      },
      {
        "command": "dbSynapse.clearFilter",
        "title": "DB Synapse: Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "dbSynapse.findReverseRefs",
        "title": "DB Synapse: Find Reverse References",
        "icon": "$(references)"
      },
      {
        "command": "dbSynapse.generateFactory",
        "title": "DB Synapse: Generate factory_boy Factory",
        "icon": "$(beaker)"
      },
      {
        "command": "dbSynapse.showDiff",
        "title": "DB Synapse: Schema Diff (Time-Travel)",
        "icon": "$(diff)"
      },
      {
        "command": "dbSynapse.findImpact",
        "title": "DB Synapse: Find Impact (What Uses This?)",
        "icon": "$(search)"
      },
      {
        "command": "dbSynapse.buildQuery",
        "title": "DB Synapse: Build Query (Insert Snippet)",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbSynapse.filter",
          "when": "view == dbSynapse.models",
          "group": "navigation@1"
        },
        {
          "command": "dbSynapse.clearFilter",
          "when": "view == dbSynapse.models",
          "group": "navigation@2"
        },
        {
          "command": "dbSynapse.refresh",
          "when": "view == dbSynapse.models",
          "group": "navigation@3"
        },
        {
          "command": "dbSynapse.showGraph",
          "when": "view == dbSynapse.models",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "dbSynapse.findReverseRefs",
          "when": "view == dbSynapse.models && viewItem == dbSynapseModel",
          "group": "navigation@1"
        },
        {
          "command": "dbSynapse.generateFactory",
          "when": "view == dbSynapse.models && viewItem == dbSynapseModel",
          "group": "navigation@2"
        },
        {
          "command": "dbSynapse.findImpact",
          "when": "view == dbSynapse.models && viewItem == dbSynapseModel",
          "group": "navigation@3"
        },
        {
          "command": "dbSynapse.findImpact",
          "when": "view == dbSynapse.models && viewItem =~ /^field/",
          "group": "navigation@1"
        },
        {
          "command": "dbSynapse.buildQuery",
          "when": "view == dbSynapse.models && viewItem == dbSynapseModel",
          "group": "navigation@4"
        },
        {
          "command": "dbSynapse.buildQuery",
          "when": "view == dbSynapse.models && viewItem =~ /^field/",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "DB Synapse",
      "properties": {
        "dbSynapse.excludeGlobs": {
          "type": "array",
          "default": [
            "**/migrations/**",
            "**/node_modules/**",
            "**/venv/**",
            "**/.venv/**",
            "**/env/**"
          ],
          "description": "Glob patterns to exclude when scanning for models.py"
        },
        "dbSynapse.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh when models.py files change"
        },
        "dbSynapse.diagramTheme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "default",
            "dark",
            "forest",
            "neutral"
          ],
          "enumDescriptions": [
            "Match the current VS Code color theme (dark or light)",
            "Mermaid's default light palette",
            "High-contrast dark palette",
            "Muted green palette",
            "Grayscale palette"
          ],
          "description": "Color theme for the ER diagram webview"
        },
        "dbSynapse.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens above each Django model class with field/relation counts and an 'Open ER diagram' action"
        },
        "dbSynapse.codeFixes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline QuickFix diagnostics for Django ORM anti-patterns (DOL001-DOL032). Disable to silence the whole rule set."
        },
        "dbSynapse.completions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Complete model field names and lookups inside Post.objects.filter(...) and its siblings, traversing ForeignKey edges for author__name paths. Disable if another extension already owns Python completion here."
        },
        "dbSynapse.dbEngine": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "postgres",
            "mysql",
            "sqlite"
          ],
          "enumDescriptions": [
            "Engine unknown: engine-specific rules keep running.",
            "PostgreSQL: skips rules written for another engine.",
            "MySQL: enables the MySQL naming convention rule (DOL017).",
            "SQLite: skips rules written for another engine."
          ],
          "description": "Database engine the project targets. Rules that only make sense on one engine (DOL017, the MySQL index naming convention) are skipped when this names another."
        },
        "dbSynapse.rules": {
          "type": "object",
          "default": {},
          "description": "Per-rule severity override. Keys are rule codes (DOL001, DOL011, ...), values are 'off' | 'hint' | 'info' | 'warning' | 'error'. Rules not listed use their default severity.",
          "patternProperties": {
            "^DOL[0-9]+$": {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "warning",
                "error"
              ]
            }
          },
          "additionalProperties": false
        },
        "dbSynapse.rulesSelect": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Ruff-style select. If non-empty, only rules matching one of these codes/prefixes run. Example: ['DOL0'] to run only queryset+model rules."
        },
        "dbSynapse.rulesIgnore": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Ruff-style ignore. Rules whose code matches any prefix here are skipped. Example: ['DOL007'] to silence just the N+1 heuristic."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p ./",
    "build:webview": "esbuild src/webview/graph.tsx --bundle --minify --outfile=media/webview/graph.js --format=iife --loader:.css=text --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\"",
    "test": "npm run build && node --test",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.3.0"
  }
}
